# OpenAI — server-side only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-proj-replace-me
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-5.6-luna

# Supabase — same public/secret split used by Lingoroom.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy projects may use these instead:
# SUPABASE_ANON_KEY=replace-me
# SUPABASE_SERVICE_ROLE_KEY=replace-me

# Netlify supplies URL automatically in production.
URL=http://localhost:3000
